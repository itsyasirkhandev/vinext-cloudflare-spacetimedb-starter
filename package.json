{
  "name": "vinext-cloudflare-spacetimedb-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Starter template: vinext (Next.js API on Vite) on Cloudflare Workers with a SpacetimeDB backend, SpacetimeAuth Google sign-in, Cloudflare R2 uploads, Effect TypeScript, shadcn/ui, and Tailwind CSS.",
  "keywords": [
    "cloudflare-r2",
    "cloudflare-workers",
    "effect",
    "effect-ts",
    "nextjs",
    "realtime",
    "shadcn-ui",
    "spacetimeauth",
    "spacetimedb",
    "starter-template",
    "tailwindcss",
    "vinext",
    "vite-plus"
  ],
  "homepage": "https://github.com/itsyasirkhandev/vinext-cloudflare-spacetimedb-starter#readme",
  "bugs": {
    "url": "https://github.com/itsyasirkhandev/vinext-cloudflare-spacetimedb-starter/issues"
  },
  "license": "Apache-2.0",
  "author": "Yasir Khan (https://github.com/itsyasirkhandev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsyasirkhandev/vinext-cloudflare-spacetimedb-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev .",
    "build": "vp build .",
    "preview": "vp preview .",
    "deploy": "vinext-cloudflare deploy",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test",
    "test:module": "pnpm --filter @starter/spacetimedb-module test",
    "typegen": "cf workers types",
    "ci": "pnpm typegen && vp check && vp test && pnpm test:module && pnpm run build",
    "spacetime:start": "spacetime start",
    "spacetime:build": "spacetime build --module-path spacetimedb",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir lib/module_bindings --module-path spacetimedb --yes",
    "spacetime:publish:local": "spacetime publish --server local --module-path spacetimedb vinext-starter --yes",
    "spacetime:publish": "spacetime publish --server maincloud --module-path spacetimedb vinext-starter",
    "fallow": "fallow",
    "react:doctor": "react-doctor . --yes --no-score --no-supply-chain --blocking none"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "effect": "4.1.5",
    "jose": "^6.2.18",
    "lucide-react": "^1.79.0",
    "oidc-client-ts": "^3.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "shadcn": "^4.23.0",
    "spacetimedb": "2.16.1",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.4",
    "fallow": "3.48.0",
    "react-doctor": "0.9.23",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.9"
}
