{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/robots.ts",
    "app/sitemap.ts",
    "cloudflare.config.ts",
    "components/ui/**"
  ],
  "ignorePatterns": ["lib/module_bindings/**"],
  "ignoreDependencies": ["next"],
  "ignoreBinaries": ["spacetime"],
  "rules": {
    "introduced-clone-group": "error",
    "weakened-tests": "error",
    "added-suppression": "error",
    "test-only-branch": "error"
  }
}
